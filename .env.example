# 빌드/실행 전 .env 파일을 복사한 뒤 값을 채워주세요.

# Google 로그인 (OAuth 2.0 클라이언트 ID · 웹 애플리케이션)
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# (로컬 개발 전용) Task 1 레이아웃 등 인증 없이 UI 검증 시 true
# npm run dev 환경에서만 적용되며, 프로덕션 빌드에서는 무시됩니다.
# VITE_AUTH_BYPASS=true
